# Copiez ce fichier en .env sur le serveur et renseignez vos valeurs.

# Domaine principal du portail et sous-domaine public de Kapsule.
# Les deux DNS doivent pointer vers l'IP du VPS.
SITE_DOMAIN=paulmondou.fr
KAPSULE_DOMAIN=kapsule.paulmondou.fr

# Inscriptions : fermees par defaut en production. Passez "open" le temps de
# creer vos comptes, puis repassez a "closed".
KAPSULE_REGISTRATION=closed

# Secret de signature des URLs d'assets d'images (ADR 003). OBLIGATOIRE.
# Generez une valeur aleatoire, par exemple : openssl rand -hex 32
# Ne committez jamais la valeur reelle (ce fichier .example ne contient qu'un
# gabarit).
KAPSULE_ASSET_SECRET=changez-moi-avec-openssl-rand-hex-32
