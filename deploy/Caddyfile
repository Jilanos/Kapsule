# Reverse proxy Caddy : HTTPS automatique (Let's Encrypt).
# SITE_DOMAIN porte le portail principal ; KAPSULE_DOMAIN porte l'application.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		# CSP adaptee a la PWA : tout en 'self' ; images data: (les decks peuvent
		# embarquer des data URIs) ; styles inline autorises (styles React).
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		# N'expose pas la stack serveur.
		-Server
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	import security_headers
	root * /srv/sites/portal
	file_server
}

www.{$SITE_DOMAIN} {
	import security_headers
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$KAPSULE_DOMAIN} {
	encode zstd gzip
	import security_headers

	reverse_proxy app:3001
}

f1.{$SITE_DOMAIN} {
	encode zstd gzip
	import security_headers
	root * /srv/sites/f1
	file_server
}

gnosis.{$SITE_DOMAIN} {
	encode zstd gzip
	import security_headers
	root * /srv/sites/gnosis
	file_server
}
