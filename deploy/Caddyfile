# Reverse proxy Caddy : HTTPS automatique (Let's Encrypt) pour Kapsule.
# Le domaine vient de la variable KAPSULE_DOMAIN (ex: kapsule.mondomaine.fr).

{$KAPSULE_DOMAIN} {
	encode zstd gzip

	# En-tetes de securite (audit 2026-07-18, AC7).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		# CSP adaptee a la PWA : tout en 'self' ; images data: (les decks peuvent
		# embarquer des data URIs) ; styles inline autorises (styles React).
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		# N'expose pas la stack serveur.
		-Server
	}

	reverse_proxy app:3001
}

# --- Ajouter une autre application sur un autre sous-domaine --------------
# Il suffit d'ajouter un bloc ici, sans toucher au conteneur Kapsule.
# Exemple :
#
# cashflow.mondomaine.fr {
# 	reverse_proxy cashflow-app:8080
# }
#
# (le conteneur correspondant doit rejoindre le meme reseau Docker que Caddy)
